rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'purich.wc@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function createsNoRawRecoverySecret() {
      return !request.resource.data.keys().hasAny(['recoveryCode']);
    }

    function updatesNoRawRecoverySecret() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(['recoveryCode'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['recoveryCode']);
    }

    function createsNoPublicRecoveryHash() {
      return !request.resource.data.keys().hasAny(['recoveryHash']);
    }

    function updatesNoPublicRecoveryHash() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(['recoveryHash'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['recoveryHash']);
    }

    match /trips/{tripId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create: if request.auth != null
        && (isSuperAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && (isSuperAdmin() || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        ));
      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if (isOwner(uid) || isSuperAdmin()) && createsNoRawRecoverySecret();
      allow update: if (isOwner(uid) || isSuperAdmin()) && updatesNoRawRecoverySecret();
      allow delete: if isSuperAdmin();

      match /boardInvites/{inviteId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow create: if request.auth != null
          && request.resource.data.targetOwnerUid == uid
          && request.resource.data.status == 'pending';
        allow update: if isSuperAdmin() || (
          request.auth != null
          && request.auth.uid == uid
          && resource.data.targetOwnerUid == uid
          && request.resource.data.targetOwnerUid == resource.data.targetOwnerUid
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.targetCharacterId == resource.data.targetCharacterId
        );
        allow delete: if isSuperAdmin();
      }
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if ((request.auth != null && request.resource.data.uid == request.auth.uid) || isSuperAdmin())
        && createsNoPublicRecoveryHash();
      allow update: if (isSuperAdmin() || (
          request.auth != null
          && (
            (
              resource.data.uid == request.auth.uid
              && request.resource.data.uid == resource.data.uid
            )
            || (
              resource.data.deleteReusable == true
              && resource.data.lifecycleStatus == 'deleted'
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.username == resource.data.username
              && request.resource.data.userId == resource.data.userId
            )
          )
        ))
        && updatesNoPublicRecoveryHash();
      allow delete: if isSuperAdmin();
    }

    match /userIds/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == userId;
      allow update: if isSuperAdmin() || (
        request.auth != null
        && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
          )
          || (
            resource.data.deleteReusable == true
            && resource.data.lifecycleStatus == 'deleted'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /playerModules/{uid} {
      allow read, create, update: if isOwner(uid) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /adminRevisions/{revisionId} {
      allow read, write: if isSuperAdmin();
    }

    match /adminDeleteRequests/{requestId} {
      allow read, write: if isSuperAdmin();
    }

    match /accountRecoveryEvents/{eventId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
