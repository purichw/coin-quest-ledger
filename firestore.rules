rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'purich.wc@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /trips/{tripId} {
      allow read, write: if true;
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create: if request.auth != null
        && (isSuperAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && (isSuperAdmin() || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        ));
      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if (request.auth != null && request.auth.uid == uid) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if (request.auth != null && request.resource.data.uid == request.auth.uid) || isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.auth != null
        && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
          )
          || (
            resource.data.deleteReusable == true
            && resource.data.lifecycleStatus == 'deleted'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.username == resource.data.username
            && request.resource.data.userId == resource.data.userId
          )
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /playerModules/{uid} {
      allow read, create, update: if (request.auth != null && request.auth.uid == uid) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /adminRevisions/{revisionId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
