{
  "expo": {
    "name": "Coin Quest Ledger",
    "slug": "coin-quest-ledger-mobile",
    "scheme": "coinquest",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "เลือกภาพใบเสร็จเพื่อแนบกับรายการของคุณ",
          "cameraPermission": "ถ่ายภาพใบเสร็จเพื่อแนบกับรายการของคุณ",
          "microphonePermission": false
        }
      ]
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.purichwc.coinquestledger",
      "supportsTablet": true
    },
    "android": {
      "package": "com.purichwc.coinquestledger",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
