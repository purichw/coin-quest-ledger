{
  "name": "coin-quest-ledger-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "exceljs": "^4.4.0",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.0.0",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --max-workers 2",
    "start:simulator": "expo start --dev-client --localhost --port 8093 --max-workers 2",
    "build:simulator": "sh scripts/build-simulator.sh",
    "device:doctor": "python3 scripts/ios-device-readiness.py --certificate-team",
    "build:device": "sh scripts/build-device.sh",
    "install:device": "sh scripts/install-device.sh",
    "test:device": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-ios-device-readiness.py",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --test tests/auth-contracts.test.mjs",
    "test:character": "node --test tests/character-contracts.test.mjs",
    "test:ledger": "node --test tests/ledger-contracts.test.mjs",
    "test:modules": "node --test tests/module-contracts.test.mjs",
    "test:qa": "node --test scripts/native-qa-emulator.test.mjs",
    "qa:emulator": "node scripts/native-qa-emulator.mjs start",
    "lint": "eslint .",
    "check:dependencies": "expo install --check"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
